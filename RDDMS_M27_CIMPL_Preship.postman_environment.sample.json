{
  "id": "rddms-m27-cimpl-preship-sample",
  "name": "RDDMS M27 CIMPL Preship (sample)",
  "_postman_variable_scope": "environment",
  "_comment": "Secret-free template. Copy to RDDMS_M27_CIMPL_Preship.postman_environment.json (gitignored) and fill secrets locally. In OSDU CI (CIMPL/AWS/GC) the platform injects access_token / ACCESS_TOKEN and the service hosts, so the collection runs WITHOUT any secrets: the '0. Get Access Token' request auto-skips when a token is already present.",
  "values": [
    {
      "key": "access_token",
      "value": "",
      "enabled": true,
      "type": "secret",
      "_comment": "Bearer token. In CI the platform sets this (or ACCESS_TOKEN, aliased by the collection prerequest). When set, self-mint is skipped."
    },
    {
      "key": "RDDMS_URL",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/reservoir-ddms/v2",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "LEGAL_URL",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/legal/v1",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "data-partition-id",
      "value": "osdu",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "domain",
      "value": ".group",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "Token_Fetch_URL",
      "value": "https://keycloak-qa.osdu-m27.osdu-cimpl.opengroup.org/realms/osdu/protocol/openid-connect/token",
      "enabled": true,
      "type": "default",
      "_comment": "Local ad-hoc self-mint only. Leave blank in CI (platform injects access_token)."
    },
    {
      "key": "CLIENT_ID",
      "value": "cimpl-users",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "CLIENT_SECRET",
      "value": "",
      "enabled": true,
      "type": "secret",
      "_comment": "Empty for public clients. Do NOT commit a real secret."
    },
    {
      "key": "grant_type",
      "value": "refresh_token",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "Scope",
      "value": "openid",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "refresh_token",
      "value": "",
      "enabled": true,
      "type": "secret",
      "_comment": "SECRET - fill locally only. Never commit. Not needed in CI."
    },
    {
      "key": "ETP_URL",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/reservoir-ddms-etp/v2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "SEARCH_HOST",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/search/v2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "STORAGE_HOST",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/storage/v2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "WORKFLOW_URL",
      "value": "https://qa.osdu-m27.osdu-cimpl.opengroup.org/api/workflow/v1",
      "type": "default",
      "enabled": true
    }
  ]
}
