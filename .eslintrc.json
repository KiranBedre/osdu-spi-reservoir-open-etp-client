{
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "env": {
    "node": true,
    "es6": true,
    "jest": true,
    "jasmine": true
  },
  "ignorePatterns": [
    // same as exclude in tsconfig.json
    "node_modules",
    "dist",
    "docs",
    "coverage",
    "src/lib/jsonTypes/Generated/"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    // Base recommended set of rules
    "eslint:recommended",
    // https://github.com/typescript-eslint/typescript-eslint/tree/master/packages/eslint-plugin/src/configs
    // recommended extends @typescript-eslint/eslint-recommended which disables some of eslint:recommended
    "plugin:@typescript-eslint/recommended",
    // Prettier config comes last as it disables conflicting ESLint rules enabled by other sets
    "prettier"
  ],
  "rules": {
    "curly": "warn",
    // Set console calls to emit warnings as not enabled by eslint:recommended
    "no-console": "warn",
    // enforce types
    "@typescript-eslint/no-explicit-any": "warn",
    // Bans specific types from being used (e.g. builtin types)
    "@typescript-eslint/ban-types": "warn",
    // enforce typed exports
    "@typescript-eslint/explicit-module-boundary-types": "warn",
    // enforce clean code
    "@typescript-eslint/no-unused-vars": "warn",
    // FIXME: temporary, to be reviewed
    "@typescript-eslint/explicit-module-boundary-types": "off",
    // FIXME: temporary, to be reviewed
    "@typescript-eslint/no-explicit-any": "off",
    // FIXME: temporary, to be reviewed
    "@typescript-eslint/no-redeclare": "off",
    // FIXME: temporary, to be reviewed
    "import/first": "off",
    // Allow unused variables that start with an underscore
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    // Type-aware promise safety: a floating/misused promise is the usual
    // symptom of a forgotten `await` on a write/commit/close.
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-promises": "warn",
    "@typescript-eslint/await-thenable": "warn"
    // Note: `require-await` is intentionally NOT enabled - it false-positives on
    // interface-conformant async signatures (builders / providers that must
    // return a Promise regardless of whether the body awaits).
  },
  "overrides": [
    {
      // Demo scripts and manual certification harnesses are not shipped runtime
      // code; the fire-and-forget promise chains there are intentional.
      "files": [
        "src/examples/**",
        "src/certification/**"
      ],
      "rules": {
        "@typescript-eslint/no-floating-promises": "off",
        "@typescript-eslint/no-misused-promises": "off"
      }
    },
    {
      // Library/server boundary (split plan, step 1).
      // The published `@osdu/open-etp-client` surface is the client graph
      // (src/lib/client + src/lib/providers and their shared deps). Nothing in
      // that graph may import the NestJS REST server (src/lib/restApi/**), so
      // library consumers never pull in the express/NestJS/apollo stack.
      // The server itself is excluded and may import freely.
      "files": [
        "src/lib/**/*.ts"
      ],
      "excludedFiles": [
        "src/lib/restApi/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/restApi",
                  "**/restApi/**"
                ],
                "message": "Client-library code must not import the REST server (src/lib/restApi/**). This boundary keeps the published @osdu/open-etp-client free of the server stack. If you need shared logic, move it into a neutral module such as src/lib/common."
              }
            ]
          }
        ]
      }
    }
  ]
}