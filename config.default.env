#
# The following fields are default values for your application environment and
# can be overwritten by setting them in a config.user.env file as advertised in
# the README.md.
################################################################################


#-------------------------------------------------------------------------------
# Remote docker images
# ETP store under test for the compose stack and the integration gate (Bruno +
# jest). Default: an open-etp-server MAIN tag, i.e. what ships. The client
# already implements DiscoveryQuery (13), GrowingObject (6) and ChannelSubscribe
# (21); server main does not negotiate them yet (open-etp-server !583 / !616).
RDMS_ETP_IMAGE=community.opengroup.org:5555/osdu/platform/domain-data-mgmt-services/reservoir/open-etp-server/open-etp-server-main:08f5b1fa895227a6343e8929b3a0b5ad60f07471
# Protocols the pinned image MUST negotiate; TestProtocolsIntegration fails in
# beforeAll when one is missing. Everything else is probed live: a protocol the
# store negotiates gets its full test block, one it lacks gets the client's
# fallback block (P3 instead of P13, 501 on growing-object routes) and the unused
# twin is reported as SKIPPED - never as passed. Keep in step with RDMS_ETP_IMAGE:
#   server main today ..........: Discovery,Store,DataArray
#   once !583 / !616 are merged : Discovery,Store,DataArray,DiscoveryQuery,GrowingObject,ChannelSubscribe
# To gate on a branch build before the merge, override both in config.user.env
# (local) or as CI variables (they win over this file), e.g.
#   RDMS_ETP_IMAGE=.../open-etp-server/open-etp-server-maap-3-growing-channel:<sha>
RDMS_ETP_PROTOCOLS=Discovery,Store,DataArray

# Use self build images by default
RDMS_REST_RUNTIME_IMAGE=osdu-reservoir-rest-api

#-------------------------------------------------------------------------------
# REST server config (this server)
# Environment variables used by server
# RDMS_REST_MAIN_URL : Base url for openAPI - "http://localhost"
# RDMS_REST_ROOT_PATH : local path inside url - "/Reservoir/v2"
RDMS_REST_ROOT_PATH="/Reservoir/v2"
# RDMS_REST_PORT : Port of openAPI - "8003"
RDMS_REST_PORT=8003
#  --- OpenAPI url is `${RDMS_REST_MAIN_URL}:${OPEN_API_PORT}${RDMS_REST_ROOT_PATH}` ---
OPEN_API_PORT=443

#-------------------------------------------------------------------------------
# Partitioning
# Partitions mode (single | multipartition)
RDMS_DATA_PARTITION_MODE=single
# Partition name for client testing
# RDMS_TEST_DATA_PARTITION_ID=test

# ETP
RDMS_AUTHENTICATION_KEY_BASE=0000000-0000-0000-0000-000000000000
# Dev-only HS256 key shared by the compose ETP server (--jwt-secret) and the
# REST proxy's GET /auth/token. Real deployments inject it from platform secrets.
# NOTE: env-cmd does not strip inline comments, so keep this line bare.
RDMS_JWT_SECRET=0123456789abcdef

# RDMS_ETP_PROTOCOL websocket protocol "ws" or "wss"
# RDMS_ETP_HOST domain of etp server
# RDMS_ETP_PORT port of ETP server
# RDMS_ETP_PATH local path in ETP server url
#  --- ETP server url is `${RDMS_ETP_PROTOCOL}://${RDMS_ETP_HOST}:${RDMS_ETP_PORT}${RDMS_ETP_PATH}/` ---

# Use WebSockets as protocol
RDMS_ETP_PROTOCOL=ws
# docker based ETP server
# cannot use host.docker.internal because it's unknown on linux
RDMS_ETP_HOST=localhost
# ETP server port (default docker based ETP server)
RDMS_ETP_PORT=9004
# Data Path location on ETP server
RDMS_ETP_PATH=

# --- Optional dedicated compute endpoint ---------------------------------
# RDMS_ETP_COMPUTE_HOST / RDMS_ETP_COMPUTE_PORT point at an open-etp-server
# started with RDMS_SERVER_ROLE=compute (read-only DataArray tier). When set,
# read-only array-compute requests (stats / reduce / where / where-multi) are
# routed there instead of the store endpoint, so the compute tier can be scaled
# independently. Protocol / TLS / path are shared with the store endpoint; only
# host and port differ. Leave unset to serve everything from the store endpoint.
# RDMS_ETP_COMPUTE_HOST=
# RDMS_ETP_COMPUTE_PORT=

# --- Optional compute batch job queue (Phase 4) --------------------------
# Batch where-multi targeting jobs (POST compute/jobs/where-multi) run
# asynchronously against the compute endpoint. These tune the in-process
# runner; defaults shown.
# RDMS_COMPUTE_JOB_CONCURRENCY=2     # max jobs run in parallel
# RDMS_COMPUTE_JOB_TTL_MS=3600000    # how long a finished result is retained
# RDMS_COMPUTE_JOB_MAX=100           # max retained jobs (oldest evicted first)

# --- Optional native-ETP front proxy (Phase 5) --------------------------
# Standalone process (node .../EtpFrontProxy.js) that fronts both tiers on one
# WebSocket endpoint for native ETP clients: sessions under the compute path
# prefix are routed to the compute upstream, everything else to the store.
# RDMS_ETP_PROXY_PORT=9100
# RDMS_ETP_PROXY_STORE_URL=ws://localhost:9004/
# RDMS_ETP_PROXY_COMPUTE_URL=ws://localhost:9005/
# RDMS_ETP_PROXY_COMPUTE_PATH=/compute

# OSDU target milestone for schema version selection ("M26" or "M27")
# M26 = Mercury (current production), M27 = Venus (next major)
# Controls which schema versions the manifest builder emits.

# Seed data for the docker-compose ETP server (init container).
# RDMS_SEED_DATA_DIR is relative to the repository root and must hold
# <project>.epc (+ its .h5 companion) for every project listed below.
# Defaults to the committed small Drogon fixture (data/Demo_Drogon.*).
RDMS_SEED_DATA_DIR=data
# Dataspace the seed projects are imported into (Bruno `seededDataspaceId`).
RDMS_SEED_DATASPACE=demo/Drogon
# List of projects to import automatically in ETP server
RDMS_PROJECTS_TO_IMPORT_IN_EML=Demo_Drogon

#-------------------------------------------------------------------------------
# EPC Upload limits
# Max EPC file size in MB (default 200)
# RDMS_EPC_MAX_SIZE_MB=200
# Max H5 file size in MB (default 2048)
# RDMS_H5_MAX_SIZE_MB=2048
# Max number of objects in a single EPC (default 10000)
# RDMS_EPC_MAX_OBJECTS=10000
