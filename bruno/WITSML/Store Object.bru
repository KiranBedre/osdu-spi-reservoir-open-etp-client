meta {
  name: Store Object
  type: http
  seq: 3
}

put {
  url: {{host}}/witsml/store
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "dataspace": "{{dataspaceIdRaw}}",
    "xml": "<Well xmlns=\"http://www.energistics.org/energyml/data/witsmlv2\" uuid=\"00000000-0000-0000-0000-000000000001\"><Citation><Title>Bruno Test Well</Title><Originator>Bruno</Originator><Creation>2026-07-10T00:00:00Z</Creation><Format>Reservoir DDMS Bruno</Format></Citation></Well>"
  }
}

tests {
  test("status is 200 or 400 or 404 or 412", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 404, 412]);
  });
}
