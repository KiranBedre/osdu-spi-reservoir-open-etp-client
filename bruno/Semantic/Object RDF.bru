meta {
  name: Object RDF
  type: http
  seq: 5
}

get {
  url: {{host}}/dataspaces/{{dataspaceId}}/resources/{{dataObjectType}}/{{guid}}/rdf
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
  Accept: text/turtle
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });
}
