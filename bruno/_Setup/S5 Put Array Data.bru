meta {
  name: S5 Put Array Data
  type: http
  seq: 5
}

put {
  url: {{host}}/dataspaces/{{dataspaceId}}/resources/arrays?transactionId={{transactionId}}
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  [
    {
      "ContainerType": "eml20.obj_EpcExternalPartReference",
      "ContainerUuid": "{{ext_guid}}",
      "PathInResource": "/RESQML/{{psr_guid}}/points_patch0",
      "Dimensions": [3, 3],
      "Data": [1, 2, 3, 4, 5, 6, 7, 8, 9],
      "ArrayType": "Float64Array"
    }
  ]
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}
