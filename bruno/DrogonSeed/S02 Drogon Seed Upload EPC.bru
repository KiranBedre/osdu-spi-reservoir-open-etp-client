meta {
  name: S02 Drogon Seed Upload EPC
  type: http
  seq: 2
}

post {
  url: {{host}}/dataspaces/{{drogonSeedId}}/epc/upload?autoIngest=true
  body: multipartForm
  auth: none
}

params:query {
  autoIngest: true
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:multipart-form {
  epc: @file(../data/Demo_Drogon.epc)
}

script:post-response {
  const s = res.getStatus();
  if (s === 200 || s === 201) {
    const b = res.getBody() || {};
    const stored = b.objectsStored ?? b.stored ?? b.object_count;
    if (stored != null) bru.setVar("drogonSeedStored", String(stored));
  }
}

docs {
  Drogon SELF-SEED (2/6). Uploads the reduced Drogon dataset (Demo_Drogon.epc
  840 KB + Demo_Drogon.h5 45 MB - the CI-sized fixture with redundant property
  arrays stripped but grid geometry, wells and kept-property arrays intact) into
  the fresh dataspace via POST /dataspaces/{ds}/epc/upload?autoIngest=true. This
  makes the suite upgrade-proof and CI-portable: no pre-seeded space required, and
  because the H5 is included the ingested arrays are readable too.

  NOTE: /epc/upload is a limited-deployment endpoint. On the CURRENT preship
  (pre-M27 client) it returns 404 and this test tolerates that (stays green). Once
  preship is upgraded to this M27 (~/rddms) client the upload succeeds and the
  downstream reads (S04/S05) and validate (S03) light up automatically.

  Bruno resolves @file() relative to the collection root (bruno/), so the paths
  are ../data/Demo_Drogon.epc and ../data/Demo_Drogon.h5. For remote CI runs this
  reduced fixture must be staged for the runner (it is git-ignored locally).
}

tests {
  test("epc upload accepted or not-yet-deployed (200/201/404/413)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 404, 413]);
  });

  test("objects were stored when upload is deployed", function () {
    const s = res.getStatus();
    if (s === 200 || s === 201) {
      const stored = Number(bru.getVar("drogonSeedStored") || "0");
      expect(stored, "objectsStored").to.be.greaterThan(0);
    } else {
      expect([404, 413]).to.include(s);
    }
  });
}
