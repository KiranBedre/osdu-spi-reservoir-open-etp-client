meta {
  name: S04 Drogon Seed List Resources
  type: http
  seq: 4
}

get {
  url: {{host}}/dataspaces/{{drogonSeedId}}/resources/all
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (Array.isArray(body)) {
      function pick(needle) {
        for (const it of body) {
          const s = (it && (it.uri || it.name)) || JSON.stringify(it);
          const m = s.match(new RegExp("([A-Za-z0-9_.]*" + needle + "[A-Za-z0-9_.]*)\\(([0-9a-fA-F-]{36})\\)"));
          if (m) return { type: m[1], guid: m[2] };
        }
        return null;
      }
      const grid = pick("IjkGrid");
      if (grid) { bru.setVar("drogonSeedGridType", grid.type); bru.setVar("drogonSeedGridGuid", grid.guid); }
    }
  }
}

docs {
  Drogon SELF-SEED (4/6). Lists the resources in the self-seeded dataspace and
  captures an IjkGrid dataObjectType+guid for the object-content read (S05). On the
  current preship the upload (S02) is a no-op (404), so this list is empty and the
  read is tolerated; after the M27 upgrade the list is populated from the uploaded
  EPC and the capture drives a real read. Read-only.
}

tests {
  test("list resources ok (200/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("captured a seeded IjkGrid guid once upload is deployed", function () {
    const guid = bru.getVar("drogonSeedGridGuid");
    const strict = bru.getVar("acceptanceStrict") === "true" || bru.getEnvVar("acceptanceStrict") === "true";
    if (guid || strict) {
      expect(guid, "seed grid guid").to.be.a("string").and.not.be.empty;
    } else {
      // Upload not yet deployed (preship pre-M27): empty dataspace is expected.
      expect(true).to.equal(true);
    }
  });
}
