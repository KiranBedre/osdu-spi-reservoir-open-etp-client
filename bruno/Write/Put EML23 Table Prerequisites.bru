meta {
  name: Put EML23 Table Prerequisites
  type: http
  seq: 5
}

put {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      var r = Math.random() * 16 | 0;
      var v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar("tableHdfUuid", uuid());
  bru.setVar("tableSwPkUuid", uuid());
  bru.setVar("tableKrwPkUuid", uuid());
}

body:json {
  [
    {
      "$type": "eml23.EpcExternalPartReference",
      "SchemaVersion": "2.3",
      "Uuid": "{{tableHdfUuid}}",
      "Citation": {
        "Title": "Bruno EML23 HDF Proxy",
        "Originator": "BrunoCLI",
        "Creation": "2026-01-01T00:00:00Z",
        "Format": "[ADME:BrunoCLI:1.0]"
      },
      "MimeType": "application/x-hdf5"
    },
    {
      "$type": "eml23.PropertyKind",
      "SchemaVersion": "2.3",
      "Uuid": "{{tableSwPkUuid}}",
      "Citation": {
        "Title": "water saturation",
        "Originator": "BrunoCLI",
        "Creation": "2026-01-01T00:00:00Z",
        "Format": "[ADME:BrunoCLI:1.0]"
      },
      "IsAbstract": false,
      "QuantityClass": "dimensionless"
    },
    {
      "$type": "eml23.PropertyKind",
      "SchemaVersion": "2.3",
      "Uuid": "{{tableKrwPkUuid}}",
      "Citation": {
        "Title": "relative permeability to water",
        "Originator": "BrunoCLI",
        "Creation": "2026-01-01T00:00:00Z",
        "Format": "[ADME:BrunoCLI:1.0]"
      },
      "IsAbstract": false,
      "QuantityClass": "dimensionless"
    }
  ]
}

docs {
  Seeds the EML 2.3 objects a RESQML 2.2 ColumnBasedTable must reference:
  an eml23 EpcExternalPartReference (the seeded CI proxy is eml20 — the
  store resolves references by type AND uuid, so a 2.2 table cannot point at
  it) plus two PropertyKind objects. Without them the table write is a
  non-transactional put with dangling references and M28 rejects it (412).
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}
