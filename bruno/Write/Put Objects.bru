meta {
  name: Put Objects
  type: http
  seq: 1
}

put {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      var r = Math.random() * 16 | 0;
      var v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar("writeSurfaceUuid", uuid());
}

body:json {
  [
    {
      "$type": "resqml20.obj_TriangulatedSetRepresentation",
      "SchemaVersion": "2.0",
      "Uuid": "{{writeSurfaceUuid}}",
      "Citation": {
        "Title": "Bruno Test Surface",
        "Originator": "Bruno Collection",
        "Creation": "2026-07-10T00:00:00Z",
        "Format": "Reservoir DDMS Bruno"
      }
    }
  ]
}

docs {
  Route coverage: PUT /dataspaces/{dataspaceId}/resources — generic
  auto-commit put of a minimal (reference-free) TriangulatedSetRepresentation.
  Deleted again by seq 4 (after seq 2-3 remove the auto-import Activity that references it).
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}
