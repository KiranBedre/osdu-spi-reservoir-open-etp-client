meta {
  name: Seeded Marker Frame Targets
  type: http
  seq: 6
}

get {
  url: {{host}}/dataspaces/{{seededDataspaceId}}/resources/resqml20.obj_WellboreMarkerFrameRepresentation/{{seededMarkerFrameUuid}}/targets
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  P3 getTargets of the seeded Marker Frame. The answer must equal the targets recorded for
  this object in the full graph (Seeded Graph Type Invariants), which makes the
  per-object route and the whole-graph route agree and - because the graph
  stores one directed link per reference - verifies A in targets(B) <=> B in
  sources(A). Type mix: Trajectory x1, WellboreInterpretation x1, >=1 Horizon/Fault interpretation (one per marker)
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("targets match the full-graph adjacency exactly", function () {
    const uuidOf = function (uri) { return uri.replace(/^.*\(([0-9a-f-]{36})\)$/, "$1"); };
    const got = res.getBody().map(function (r) { return uuidOf(r.uri); })
      .filter(function (v, i, a) { return a.indexOf(v) === i; }).sort();
    const want = JSON.parse(bru.getVar("seededGraphTargets"))[bru.getVar("seededMarkerFrameUuid")];
    expect(want, "adjacency captured").to.be.an("array");
    expect(got).to.deep.equal(want);
  });

  test("marker frame references its trajectory, interpretation and the marker boundaries", function () {
    const typeOf = function (uri) { return uri.replace(/^.*\/(?:resqml20|eml20)\.(obj_[A-Za-z0-9]+)\(.*$/, "$1"); };
    const counts = {};
    res.getBody().forEach(function (r) { const t = typeOf(r.uri); counts[t] = (counts[t] || 0) + 1; });
    expect(counts.obj_WellboreTrajectoryRepresentation, "trajectory").to.equal(1);
    expect(counts.obj_WellboreInterpretation, "wellbore interpretation").to.equal(1);
    expect((counts.obj_HorizonInterpretation || 0) + (counts.obj_FaultInterpretation || 0), "boundary interpretations").to.be.at.least(1);
    bru.setVar("seededMarkerBoundaryCount", String((counts.obj_HorizonInterpretation || 0) + (counts.obj_FaultInterpretation || 0)));
  });
}
