meta {
  name: CL2 Verify Cleanup
  type: http
  seq: 2
}

get {
  url: {{host}}/dataspaces
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("test dataspace no longer listed", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    const ids = body.map(ds => {
      const fromUri = /^eml:\/\/\/dataspace\('([^']+)'\)$/.exec(ds.uri || "");
      return fromUri && fromUri[1];
    });
    ids.forEach(id => expect(id).to.be.a("string").and.not.equal(""));
    const testDs = bru.getVar("testDataspaceIdRaw") || "test/bruno-collection";
    expect(ids).to.not.include(testDs);
  });
}
