meta {
  name: Server Info
  type: http
  seq: 3
}

get {
  url: {{host}}/info
  body: none
  auth: none
}

docs {
  GET /info - server version and build metadata. GET /health/info is the
  deprecated M26 alias of this route (kept for 0.29 clients).
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns version info", function () {
    const body = res.getBody();
    expect(body).to.have.property("version");
  });
}
