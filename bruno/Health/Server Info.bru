meta {
  name: Server Info
  type: http
  seq: 3
}

get {
  url: {{host}}/health/info
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns version info", function () {
    const body = res.getBody();
    expect(body).to.have.property("version");
  });
}
