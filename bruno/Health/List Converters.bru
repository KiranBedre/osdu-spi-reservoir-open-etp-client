meta {
  name: List Converters
  type: http
  seq: 4
}

get {
  url: {{host}}/health/converters
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns converter list", function () {
    const body = res.getBody();
    // Server may return array or {count, items}
    const items = Array.isArray(body) ? body : (body.items || []);
    expect(items.length || body.count).to.be.greaterThan(0);
  });
}
