meta {
  name: Put Cell Fluid Phase Units
  type: http
  seq: 14
}

put {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  const grid = JSON.parse(bru.getVar("gridsGridJson"));
  grid["CellFluidPhaseUnits"] = {
    "FluidOrganization": {
      "$type": "eml20.DataObjectReference",
      "ContentType": "application/x-resqml+xml;version=2.2;type=RockFluidOrganizationInterpretation",
      "Title": "Rock-fluid organisation",
      "UUID": bru.getVar("gridsOrgUuid")
    },
    "PhaseUnitIndices": {
      "$type": "resqml20.IntegerHdf5Array",
      "NullValue": -1,
      "Values": {
        "$type": "eml20.Hdf5Dataset",
        "PathInHdfFile": "/RESQML/" + bru.getVar("gridsGridUuid") + "/cellFluidPhaseUnits",
        "HdfProxy": {
          "$type": "eml20.DataObjectReference",
          "ContentType": "application/x-resqml+xml;version=2.0;type=obj_EpcExternalPartReference",
          "Title": "Hdf Proxy",
          "UUID": bru.getVar("gridsProxyUuid")
        }
      }
    }
  };
  bru.setVar("gridsGridJson", JSON.stringify(grid));
  req.setBody([grid]);
}

body:json {
  []
}

docs {
  Replaces PUT /grids/{uuid}/fluid-phase-units: buildCellFluidPhaseUnits child
  (phaseUnitIndices [0,0,1,-1] against the RockFluidOrganizationInterpretation
  from Put Rock Fluid Model) merged onto the grid and rewritten.
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("store accepted the objects (body is true)", function () {
    expect(res.getBody()).to.equal(true);
  });
}
