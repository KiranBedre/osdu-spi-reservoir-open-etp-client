meta {
  name: Export Grid
  type: http
  seq: 2
}

get {
  url: {{host}}/dataspaces/{{testDataspaceId}}/grids/{{gridsGridUuid}}/export?format=grdecl
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: GET /dataspaces/{dataspaceId}/grids/{uuid}/export — round-
  trips the grid imported by seq 1 back to a GRDECL ASCII deck.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("GRDECL deck with geometry keywords", function () {
    const text = typeof res.getBody() === "string" ? res.getBody() : JSON.stringify(res.getBody());
    expect(text).to.include("SPECGRID");
    expect(text).to.include("COORD");
    expect(text).to.include("ZCORN");
  });
}
