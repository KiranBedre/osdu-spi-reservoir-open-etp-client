meta {
  name: List Arrays
  type: http
  seq: 1
}

get {
  url: {{host}}/dataspaces/{{dataspaceId}}/resources/{{dataObjectType}}/{{guid}}/arrays
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (Array.isArray(body) && body.length > 0 && body[0].pathInResource) {
      bru.setVar("pathInResource", encodeURIComponent(body[0].pathInResource));
    }
  }
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });
}
