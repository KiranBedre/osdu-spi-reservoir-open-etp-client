meta {
  name: A2 Get Array Metadata
  type: http
  seq: 2
}

get {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources/eml20.obj_EpcExternalPartReference/{{ext_guid}}/arrays/{{array_path_encoded}}/metadata
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("metadata describes the 3x3 Float64 array", function () {
    const body = res.getBody();
    expect(body.uid.pathInResource).to.equal("/RESQML/" + bru.getVar("psr_guid") + "/points_patch0");
    expect(body.dimensions.map(Number)).to.deep.equal([3, 3]);
    // ETP AnyArrayType: 4 = arrayOfDouble
    expect(body.transportArrayType).to.equal(4);
  });
}
