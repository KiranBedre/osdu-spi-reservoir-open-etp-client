meta {
  name: A8 Read Back Int8 Array
  type: http
  seq: 8
}

get {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources/eml20.obj_EpcExternalPartReference/{{ext_guid}}/arrays/{{bin_array_path_encoded}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Regression: Int8/boolean arrays are transported as ETP `_bytes`; the client
  used to stringify the Buffer's `values()` method instead of the bytes.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Int8 bytes 65..72 round-trip as numbers in a 2x4 array", function () {
    const body = res.getBody();
    expect(body.data.dimensions.map(Number)).to.deep.equal([2, 4]);
    expect(body.data.data).to.be.an("array");
    expect(body.data.data).to.deep.equal([65, 66, 67, 68, 69, 70, 71, 72]);
  });
}
