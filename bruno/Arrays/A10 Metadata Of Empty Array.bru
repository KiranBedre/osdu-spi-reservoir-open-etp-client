meta {
  name: A10 Metadata Of Empty Array
  type: http
  seq: 10
}

get {
  url: {{host}}/dataspaces/{{testDataspaceId}}/resources/eml20.obj_EpcExternalPartReference/{{ext_guid}}/arrays/{{empty_array_path_encoded}}/metadata
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("declared 2x2 shape is visible before any data is written", function () {
    const body = res.getBody();
    expect(body.uid.pathInResource).to.equal("/RESQML/" + bru.getVar("psr_guid") + "/empty_patch3");
    expect(body.dimensions.map(Number)).to.deep.equal([2, 2]);
  });
}
