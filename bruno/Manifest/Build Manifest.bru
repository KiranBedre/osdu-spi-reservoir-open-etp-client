meta {
  name: Build Manifest
  type: http
  seq: 1
}

post {
  url: {{host}}/manifests/build
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "uris": ["eml:///dataspace('demo/Volve')"],
    "typePatterns": ["*"],
    "createMissingReferences": true,
    "tags": {}
  }
}

docs {
  ## Build Manifest

  Builds an OSDU manifest from ETP dataspace content.

  **propertyFilter** (new):
  - `"canonical"` (default) — include properties with standard names: PWLS (porosity, water saturation…), OSDU PropertyType aliases, and common simulator abbreviations (PORO, PERMX, SW, SATNUM, NTG…)
  - `"none"` — exclude all properties from manifest
  - `"all"` — include all properties regardless of name

  **typePatterns behavior:**
  - `["*"]` — include all types (overrides propertyFilter)
  - Omit field — default patterns apply, propertyFilter controls which properties are included
  - `["*Property", "*Representation"]` — explicit inclusion of all properties

  **Enrichments:**
  - GridConnectionSet records include `HasTransmissibilityMultipliers` in ExtensionProperties
  - WellLog records auto-populate TopMeasuredDepth/BottomMeasuredDepth from frame arrays
  - eml23.ColumnBasedTable → WPC--ColumnBasedTable with column names, UOM, and inferred table type
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns manifest with Data", function () {
    const body = res.getBody();
    expect(body).to.have.property("Data");
  });
}
