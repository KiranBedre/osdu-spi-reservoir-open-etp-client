meta {
  name: Syntax Error (negative)
  type: http
  seq: 4
}

post {
  url: {{host}}/cypher
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "dataspaceUri": "eml:///dataspace('{{seededDataspaceIdRaw}}')",
    "query": "CREATE (n:Grid) RETURN n"
  }
}

docs {
  Route coverage: POST /cypher — negative test. Write clauses (CREATE/MERGE/SET/
  DELETE), WITH, UNWIND and CALL are rejected by the read-only subset with a
  descriptive HTTP 400 before any ETP session is opened.
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("descriptive error", function () {
    const body = res.getBody();
    expect(JSON.stringify(body)).to.match(/CREATE|not supported/i);
  });
}
