meta {
  name: List Dataspaces
  type: http
  seq: 1
}

get {
  url: {{host}}/dataspaces
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: GET /dataspaces. The seeded fixture dataspace and the _Setup
  scratch dataspace must both be listed; ids are never derived from this list
  (the environment is the single source of truth, see README "Dataspace contract").
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("lists the seeded and the _Setup dataspaces", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    const paths = body.map(function (d) { return d.path; });
    expect(paths).to.include(bru.getEnvVar("seededDataspaceIdRaw"));
    expect(paths).to.include(bru.getEnvVar("testDataspaceIdRaw"));
  });
}
