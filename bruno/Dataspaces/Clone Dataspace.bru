meta {
  name: Clone Dataspace
  type: http
  seq: 4
}

post {
  url: {{host}}/dataspaces/{{testDataspaceId}}/clone
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "DataspaceId": "{{cloneDataspaceIdRaw}}",
    "Path": "{{cloneDataspaceIdRaw}}",
    "CustomData": {
      "viewers": ["{{defaultViewers}}"],
      "owners": ["{{defaultOwners}}"],
      "legaltags": ["{{defaultLegalTag}}"],
      "otherRelevantDataCountries": ["US"]
    }
  }
}

docs {
  Route coverage: POST /dataspaces/{id}/clone (server-side deep copy into a NEW
  dataspace, same object UUIDs). Source is the _Setup scratch dataspace; the
  clone is removed by the next request.
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("returns the clone uri", function () {
    expect(res.getBody()).to.equal("eml:///dataspace('" + bru.getEnvVar("cloneDataspaceIdRaw") + "')");
  });
}
