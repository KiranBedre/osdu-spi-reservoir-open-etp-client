meta {
  name: Clone Dataspace
  type: http
  seq: 4
}

post {
  url: {{host}}/dataspaces/{{testDataspaceId}}/clone
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "DataspaceId": "{{cloneDataspaceIdRaw}}",
    "Path": "{{cloneDataspaceIdRaw}}",
    "CustomData": {
      "viewers": ["{{defaultViewers}}"],
      "owners": ["{{defaultOwners}}"],
      "legaltags": ["{{defaultLegalTag}}"],
      "otherRelevantDataCountries": ["US"]
    }
  }
}

script:pre-request {
  const strict = bru.getVar("acceptanceStrict") === "true" || bru.getEnvVar("acceptanceStrict") === "true";
  const id = strict ? (bru.getVar("acceptanceCloneIdRaw") || bru.getEnvVar("acceptanceCloneIdRaw")) : "test/bruno-clone";
  if (!id) throw new Error("Missing acceptance clone dataspace ID");
  bru.setVar("cloneDataspaceIdRaw", id);
}

tests {
  // 403 = CI principal lacks create/clone entitlement on ACL-restricted envs
  // (e.g. prod.osdu-main); 409 = clone target already exists. Consistent with
  // Create Dataspace so cimpl-prod-test is not failed by missing entitlements.
  test("status is 200 or 201 or 400 or 403 or 404 or 409", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 403, 404, 409]);
  });
}
