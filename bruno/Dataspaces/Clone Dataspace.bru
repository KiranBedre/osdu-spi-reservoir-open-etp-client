meta {
  name: Clone Dataspace
  type: http
  seq: 4
}

post {
  url: {{host}}/dataspaces/{{testDataspaceId}}/clone
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "DataspaceId": "test/bruno-clone",
    "Path": "test/bruno-clone"
  }
}

tests {
  test("status is 200 or 201 or 400 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 404]);
  });
}
