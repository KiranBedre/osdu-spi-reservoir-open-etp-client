meta {
  name: Export EPC
  type: http
  seq: 14
}

get {
  url: {{host}}/dataspaces/{{testDataspaceId}}/epc?includeReferences=true
  body: none
  auth: none
}

params:query {
  includeReferences: true
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: GET /dataspaces/{id}/epc streams the _Setup scratch dataspace
  (CRS + HDF proxy + point set) back as an EPC (ZIP) archive.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response is a ZIP (EPC) package", function () {
    const ct = String(res.getHeader("content-type") || "");
    expect(ct).to.match(/zip|octet-stream|epc/i);
  });
}
