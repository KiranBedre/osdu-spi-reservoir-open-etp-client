meta {
  name: Create Dataspace
  type: http
  seq: 3
}

post {
  url: {{host}}/dataspaces
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  [
    {
      "DataspaceId": "{{crudDataspaceIdRaw}}",
      "Path": "{{crudDataspaceIdRaw}}",
      "CustomData": {
        "viewers": ["{{defaultViewers}}"],
        "owners": ["{{defaultOwners}}"],
        "legaltags": ["{{defaultLegalTag}}"],
        "otherRelevantDataCountries": ["US"]
      }
    }
  ]
}

docs {
  Route coverage: POST /dataspaces. Creates the folder-private CRUD dataspace
  (crudDataspaceId) that the lock/unlock/upload/delete requests below operate
  on; "Delete Dataspace" removes it again at the end of this folder.
}

tests {
  test("status is 200 or 201", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("returns the created dataspace uri", function () {
    expect(res.getBody()).to.include("eml:///dataspace('" + bru.getEnvVar("crudDataspaceIdRaw") + "')");
  });
}
