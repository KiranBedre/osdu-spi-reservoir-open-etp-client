meta {
  name: Create Dataspace
  type: http
  seq: 3
}

post {
  url: {{host}}/dataspaces
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  [
    {
      "DataspaceId": "{{collectionDataspaceIdRaw}}",
      "Path": "{{collectionDataspaceIdRaw}}",
      "CustomData": {
        "viewers": ["{{defaultViewers}}"],
        "owners": ["{{defaultOwners}}"],
        "legaltags": ["{{defaultLegalTag}}"],
        "otherRelevantDataCountries": ["US"]
      }
    }
  ]
}

script:pre-request {
  const strict = bru.getVar("acceptanceStrict") === "true" || bru.getEnvVar("acceptanceStrict") === "true";
  const id = strict ? (bru.getVar("acceptanceCrudIdRaw") || bru.getEnvVar("acceptanceCrudIdRaw")) : "test/bruno-collection";
  if (!id) throw new Error("Missing acceptance CRUD dataspace ID");
  bru.setVar("collectionDataspaceIdRaw", id);
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const id = bru.getVar("collectionDataspaceIdRaw");
    bru.setVar("testDataspaceId", encodeURIComponent(id));
    if (bru.getVar("acceptanceStrict") === "true" || bru.getEnvVar("acceptanceStrict") === "true") {
      bru.setVar("testDataspaceIdRaw", id);
    }
  }
}

tests {
  test("status is 200 or 201 or 403 or 409", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 403, 409]);
  });
}
