meta {
  name: Create Dataspace
  type: http
  seq: 3
}

post {
  url: {{host}}/dataspaces
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  [
    {
      "DataspaceId": "test/bruno-collection",
      "Path": "test/bruno-collection"
    }
  ]
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    bru.setVar("testDataspaceId", encodeURIComponent("test/bruno-collection"));
  }
}

tests {
  test("status is 200 or 201 or 403 or 409", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 403, 409]);
  });
}
