meta {
  name: Unlock Dataspace
  type: http
  seq: 12
}

delete {
  url: {{host}}/dataspaces/{{crudDataspaceId}}/lock
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: DELETE /dataspaces/{id}/lock on the folder-private CRUD dataspace.
}

tests {
  test("status is 200 and dataspace is unlocked", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody(), "dataspace unlocked").to.equal(true);
  });
}
