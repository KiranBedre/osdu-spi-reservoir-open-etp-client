meta {
  name: Lock Dataspace
  type: http
  seq: 11
}

post {
  url: {{host}}/dataspaces/{{crudDataspaceId}}/lock
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: POST /dataspaces/{id}/lock on the folder-private CRUD dataspace.
}

tests {
  test("status is 200 and dataspace is locked", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody(), "dataspace locked").to.equal(true);
  });
}
