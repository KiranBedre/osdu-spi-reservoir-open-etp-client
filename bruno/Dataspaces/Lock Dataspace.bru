meta {
  name: Lock Dataspace
  type: http
  seq: 5
}

post {
  url: {{host}}/dataspaces/{{dataspaceId}}/lock
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

tests {
  test("status is 200 or 201 or 404 or 409", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 404, 409]);
  });
}
