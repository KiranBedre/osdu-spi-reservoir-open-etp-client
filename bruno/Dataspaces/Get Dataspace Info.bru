meta {
  name: Get Dataspace Info
  type: http
  seq: 2
}

get {
  url: {{host}}/dataspaces/{{seededDataspaceId}}/info
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Route coverage: GET /dataspaces/{id}/info for the seeded fixture dataspace.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("describes the seeded dataspace", function () {
    const b = res.getBody();
    expect(b.path).to.equal(bru.getEnvVar("seededDataspaceIdRaw"));
    expect(b.uri).to.equal("eml:///dataspace('" + bru.getEnvVar("seededDataspaceIdRaw") + "')");
    expect(b.customData).to.be.an("object");
  });
}
