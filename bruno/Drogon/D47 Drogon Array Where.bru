meta {
  name: D47 Drogon Array Where
  type: http
  seq: 47
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonPropType}}/{{drogonStatGuid}}/arrays/{{drogonStatArray}}/compute?op=where&rangeLo=0.1&rangeHi=0.3
  body: none
  auth: none
}

params:query {
  op: where
  rangeLo: 0.1
  rangeHi: 0.3
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("drogonWhereCount", res.getBody().count);
  }
}

docs {
  Array-compute coverage (7/31). GetDataArrayWhere evaluates a single
  [rangeLo, rangeHi] predicate inside the store and returns the count of
  matching cells, their inclusive ijk bounding box and ijk centroid (aim point)
  — the single-criterion targeting primitive.

  Cross-checks: the WHERE count over [0.1, 0.3] must equal the STATS
  inRangeCount over the same window (D43) — two different code paths, one
  answer; the bbox must sit inside the grid dimensions of D41 (i < Ni, j < Nj,
  k < Nk, non-square grid so a swapped i/j would overflow); the centroid must
  lie inside the bbox.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("count, bbox and centroid returned", function () {
    const b = res.getBody();
    expect(b.valid).to.equal(true);
    expect(b.count).to.be.a("number").greaterThan(0);
    ["iMin", "iMax", "jMin", "jMax", "kMin", "kMax"].forEach(function (k) {
      expect(b[k], k).to.be.a("number");
    });
    expect(b.iMin).to.be.at.most(b.iMax);
    ["ci", "cj", "ck"].forEach(function (k) {
      expect(b[k], k).to.be.a("number");
    });
  });

  test("WHERE count equals STATS inRangeCount over the same window", function () {
    const b = res.getBody();
    expect(b.count).to.equal(Number(bru.getVar("drogonInRange")));
  });

  test("mask is the two k=0 cells holding 0.15 and 0.25", function () {
    const b = res.getBody();
    // C-order [k][j][i]: 0.15 -> (k0,j0,i1), 0.25 -> (k0,j1,i0).
    expect(b.count).to.equal(2);
    expect([b.kMin, b.kMax]).to.deep.equal([0, 0]);
    expect([b.iMin, b.iMax, b.jMin, b.jMax]).to.deep.equal([0, 1, 0, 1]);
    expect(b.ck).to.equal(0);
    expect(b.ci).to.equal(0.5);
    expect(b.cj).to.equal(0.5);
  });

  test("bbox inside grid dims and centroid inside bbox", function () {
    const b = res.getBody();
    const ni = Number(bru.getVar("drogonNi"));
    const nj = Number(bru.getVar("drogonNj"));
    const nk = Number(bru.getVar("drogonNk"));
    expect(b.iMin).to.be.at.least(0);
    expect(b.jMin).to.be.at.least(0);
    expect(b.kMin).to.be.at.least(0);
    if (ni > 0 && nj > 0 && nk > 0) {
      expect(b.iMax).to.be.below(ni);
      expect(b.jMax).to.be.below(nj);
      expect(b.kMax).to.be.below(nk);
    }
    expect(b.ci).to.be.at.least(b.iMin).at.most(b.iMax);
    expect(b.cj).to.be.at.least(b.jMin).at.most(b.jMax);
    expect(b.ck).to.be.at.least(b.kMin).at.most(b.kMax);
  });
}
