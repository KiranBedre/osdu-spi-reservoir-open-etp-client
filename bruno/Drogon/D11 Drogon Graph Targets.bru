meta {
  name: D11 Drogon Graph Targets
  type: http
  seq: 11
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/graph/{{drogonGridType}}/{{drogonGridGuid}}/targets
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (graph targets). Traverses the DOR edges the Drogon IJK grid
  points AT (its supporting/target objects) via the graph/:type/:guid/targets
  route. Tolerant of 404 when the grid guid could not be captured upstream.
}

tests {
  test("status is documented (200/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("returns graph payload when 200", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
    }
  });
}
