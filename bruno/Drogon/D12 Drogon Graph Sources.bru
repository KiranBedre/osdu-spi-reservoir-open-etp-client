meta {
  name: D12 Drogon Graph Sources
  type: http
  seq: 12
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/graph/{{drogonGridType}}/{{drogonGridGuid}}/sources
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (graph sources). Traverses the DOR edges that point AT the
  Drogon IJK grid (e.g. properties referencing it as SupportingRepresentation)
  via the graph/:type/:guid/sources route. Tolerant of 404 when the grid guid
  could not be captured upstream.
}

tests {
  test("status is documented (200/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("returns graph payload when 200", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
    }
  });
}
