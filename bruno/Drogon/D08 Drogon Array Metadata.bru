meta {
  name: D08 Drogon Array Metadata
  type: http
  seq: 8
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonGridType}}/{{drogonGridGuid}}/arrays/{{drogonArrayPath}}/metadata
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (7/15). Reads array metadata (dimensions, element type,
  transport) for the array captured in D06 — the ETP GetDataArrayMetadata path.
  Accepts 400/404 when no array path was captured so the folder stays robust.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("metadata describes the 3x9x3 points array", function () {
    const body = res.getBody();
    const m = Array.isArray(body) ? body[0] : body;
    expect(m.uid.pathInResource).to.equal("/RESQML/" + bru.getVar("drogonGridGuid") + "/points");
    expect(m.dimensions).to.deep.equal([3, 9, 3]);
  });
}
