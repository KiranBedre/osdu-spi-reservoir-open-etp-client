meta {
  name: D61 Drogon Array Stats Guard Lo Above Hi
  type: http
  seq: 61
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonPropType}}/{{drogonStatGuid}}/arrays/{{drogonStatArray}}/compute?op=stats&rangeLo=0.3&rangeHi=0.1
  body: none
  auth: none
}

params:query {
  op: stats
  rangeLo: 0.3
  rangeHi: 0.1
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Array-compute coverage (21/31). Guard: inverted window (lo > hi) is rejected by the store with 400
      (EINVALID_ARGUMENT -> 400), never silently swapped or treated as empty.
}

tests {
  test("status is 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("error message names the violated rule", function () {
        const b = res.getBody();
        const msg = String((b && (b.description || b.message)) || "");
        expect(msg.toLowerCase()).to.include('lo > hi');
      });
}
