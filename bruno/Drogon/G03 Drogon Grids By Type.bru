meta {
  name: G03 Drogon Grids By Type
  type: http
  seq: 3
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonGridType}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (grids by type). Lists resources of the captured IjkGrid type.
  Tolerant of 400/404 when no grid type was captured upstream.
}

tests {
  test("status is documented (200/400/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
  });

  test("returns an array when 200", function () {
    if (res.getStatus() === 200) {
      expect(res.getBody()).to.be.an("array");
    }
  });
}
