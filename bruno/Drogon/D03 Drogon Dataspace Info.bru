meta {
  name: D03 Drogon Dataspace Info
  type: http
  seq: 3
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/info
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (info). Reads the dataspace metadata block (GetDataspaces /
  dataspace info) right after creation, confirming the demo/Drogon dataspace is
  addressable before the EPC upload and rich reads below.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a dataspace info object", function () {
    const body = res.getBody();
    expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
  });
}
