meta {
  name: D13 Drogon Get Multiple Objects
  type: http
  seq: 13
}

post {
  url: {{host}}/dataspaces/multi-resources/get-content
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "uris": ["{{drogonGridUri}}"]
  }
}

docs {
  Drogon lifecycle (multi get-content). Batch-reads object content for a list of
  uris in one call (GetDataObjects over multiple resources) using the grid uri
  captured in D04. Tolerant of 400/404 when the grid uri could not be captured.
}

tests {
  test("status is documented (200/201/400/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 400, 404]);
  });

  test("returns content payload when 2xx", function () {
    if (res.getStatus() === 200 || res.getStatus() === 201) {
      const body = res.getBody();
      expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
    }
  });
}
