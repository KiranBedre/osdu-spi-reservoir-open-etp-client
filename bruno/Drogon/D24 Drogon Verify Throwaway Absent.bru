meta {
  name: D24 Drogon Verify Throwaway Absent
  type: http
  seq: 24
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonPropType}}/{{drogonRbPropGuid}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (rollback 4/4). Proves rollback semantics: the throwaway
  property written inside the rolled-back transaction (D22) must NOT be readable
  outside it. Accepts 404 (not found) or 400; a 200 would mean the rollback did
  not discard the write.
}

tests {
  test("throwaway property is absent (404/400)", function () {
    expect(res.getStatus()).to.be.oneOf([404, 400]);
  });
}
