meta {
  name: D39 Drogon Read Back Well Frame Categorical
  type: http
  seq: 39
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/resqml20.obj_CategoricalProperty/{{drogonFrameCatGuid}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Geometry/property coverage (10/10). Reads back the categorical well-log property
  added to the WellboreFrameRepresentation in D34 (after commit D35), completing the
  {continuous,categorical} x {IJK grid, 2D grid, well log} write coverage matrix.
}

tests {
  test("status is 200 (well log categorical persisted)", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the added property content", function () {
    const body = res.getBody();
    expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
  });
}
