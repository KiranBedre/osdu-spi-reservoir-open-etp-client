meta {
  name: D10 Drogon Graph All
  type: http
  seq: 10
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/all?edges=true
  body: none
  auth: none
}

params:query {
  edges: true
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (8/15). Relationship graph read (resources/all?edges=true, the
  current equivalent of the deprecated graph/all). Verifies DOR edges between the
  grid, its properties and supporting representations are traversable on real data.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns graph payload", function () {
    const body = res.getBody();
    expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
  });
}
