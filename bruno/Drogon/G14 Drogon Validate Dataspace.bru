meta {
  name: G14 Drogon Validate Dataspace
  type: http
  seq: 14
}

post {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/validate
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (validate). Validates the RESQML objects in the seeded Drogon
  dataspace (POST /dataspaces/:ds/validate). Read-only check that the real data is
  self-consistent. Tolerant of 400/404/501.
}

tests {
  test("status is documented (200/400/404/501)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404, 501]);
  });
}
