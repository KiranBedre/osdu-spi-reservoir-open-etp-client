meta {
  name: G19 Drogon Read Back Object
  type: http
  seq: 19
}

get {
  url: {{host}}/dataspaces/{{drogonThrowawayId}}/resources/resqml20.obj_LocalDepth3dCrs/{{drogonObjGuid}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (write 5/14). Verifies the write round-trip: reads back the CRS
  object added in G17 (after the commit in G18) and asserts it resolves.
}

tests {
  test("status is 200 (object persisted)", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the object content", function () {
    const body = res.getBody();
    expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
  });
}
