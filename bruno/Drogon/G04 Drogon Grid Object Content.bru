meta {
  name: G04 Drogon Grid Object Content
  type: http
  seq: 4
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/resources/{{drogonGridType}}/{{drogonGridGuid}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (object content). Reads the full object content of the captured
  Drogon IjkGrid - the REST -> ETP -> real-RESQML round trip. Tolerant of 400/404.
}

tests {
  test("status is documented (200/400/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
  });

  test("returns object content when 200", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body, JSON.stringify(body).slice(0, 200)).to.not.be.undefined;
    }
  });
}
