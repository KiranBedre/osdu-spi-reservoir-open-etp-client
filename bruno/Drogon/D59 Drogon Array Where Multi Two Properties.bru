meta {
  name: D59 Drogon Array Where Multi Two Properties
  type: http
  seq: 59
}

post {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/arrays/compute
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "op": "where-multi",
    "predicates": [
        {
          "dataObjectType": "{{drogonPropType}}",
          "guid": "{{drogonStatGuid}}",
          "pathInResource": "/RESQML/{{drogonStatGuid}}/values_patch0",
          "rangeLo": 0.1,
          "rangeHi": 0.3
        },
        {
          "dataObjectType": "resqml20.obj_DiscreteProperty",
          "guid": "{{drogonStatGuid2}}",
          "pathInResource": "/RESQML/{{drogonStatGuid2}}/values_patch0",
          "rangeLo": 1,
          "rangeHi": 1
        }
    ]
  }
}

docs {
  Array-compute coverage (19/31). WHEREN across TWO different property arrays on the same grid:
      PORO in [0.1, 0.3] AND EQLNUM == 1 (region code). The intersection is a
      subset of each operand: count <= WHERE count of PORO alone (D47) and count
      <= the EQLNUM==1 population (D52). bbox / centroid / largest-body
      consistency as in D48.
}

tests {
  test("status is 200", function () {
        expect(res.getStatus()).to.equal(200);
      });

      test("intersection is a subset of both operands", function () {
        const b = res.getBody();
        expect(b.valid).to.equal(true);
        expect(b.arrays).to.equal(2);
        expect(b.count).to.be.greaterThan(0);
        expect(b.count).to.be.at.most(Number(bru.getVar("drogonWhereCount")));
        expect(b.count).to.be.at.most(Number(bru.getVar("drogonEqlnum1Count")));
      });

      test("bbox inside grid, centroid inside bbox, body inside passing set", function () {
        const b = res.getBody();
        const ni = Number(bru.getVar("drogonNi"));
        const nj = Number(bru.getVar("drogonNj"));
        const nk = Number(bru.getVar("drogonNk"));
        if (ni > 0 && nj > 0 && nk > 0) {
          expect(b.iMax).to.be.below(ni);
          expect(b.jMax).to.be.below(nj);
          expect(b.kMax).to.be.below(nk);
        }
        expect(b.ci).to.be.at.least(b.iMin).at.most(b.iMax);
        expect(b.cj).to.be.at.least(b.jMin).at.most(b.jMax);
        expect(b.ck).to.be.at.least(b.kMin).at.most(b.kMax);
        expect(b.components).to.be.at.least(1);
        expect(b.bodyCount).to.be.at.least(1).at.most(b.count);
      });
}
