meta {
  name: G21 Drogon Put Throwaway Object In Txn
  type: http
  seq: 21
}

put {
  url: {{host}}/dataspaces/{{drogonThrowawayId}}/resources?transactionId={{drogonRbTxnId}}
  body: json
  auth: none
}

params:query {
  transactionId: {{drogonRbTxnId}}
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      var r = Math.random() * 16 | 0;
      var v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar("drogonRbObjGuid", uuid());
}

body:json {
  [
    {
      "$type": "resqml20.obj_LocalDepth3dCrs",
      "SchemaVersion": "2.0",
      "Uuid": "{{drogonRbObjGuid}}",
      "Citation": {
        "Title": "Drogon Rollback Probe CRS",
        "Originator": "BrunoCLI",
        "Creation": "2026-01-01T00:00:00Z",
        "Format": "[ADME:BrunoCLI:1.0]"
      },
      "XOffset": 0,
      "YOffset": 0,
      "ZOffset": 0,
      "ArealRotation": { "_": 0, "$type": "eml20.PlaneAngleMeasure", "Uom": "dega" },
      "ProjectedAxisOrder": "easting northing",
      "ProjectedUom": "m",
      "VerticalUom": "m",
      "ZIncreasingDownward": true,
      "VerticalCrs": { "$type": "eml20.VerticalUnknownCrs", "Unknown": "unknown" },
      "ProjectedCrs": { "$type": "eml20.ProjectedUnknownCrs", "Unknown": "WKT" }
    }
  ]
}

docs {
  Drogon lifecycle (rollback 2/4). Writes a throwaway CRS INSIDE the uncommitted
  rollback transaction from G20. It is never committed - G22 rolls it back and G23
  proves it is absent.
}

tests {
  test("status is 200 or 201 (throwaway written in txn)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}
