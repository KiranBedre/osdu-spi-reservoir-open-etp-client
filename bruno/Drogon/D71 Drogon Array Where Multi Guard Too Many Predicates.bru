docs {
  Array-compute coverage (31/31). Guard: WHEREN accepts at most 16 predicates per request; 17
      entries -> 400 naming the ceiling. Also covers the shape-mismatch rule
      implicitly: all entries here are the same grid, so the ONLY reason to reject
      is the entry count.
}

tests {
  test("status is 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("error message names the predicate ceiling", function () {
        const b = res.getBody();
        const msg = String((b && (b.description || b.message)) || "");
        expect(msg).to.include("16");
      });
}
