meta {
  name: Growing Object Range
  type: http
  seq: 5
}

post {
  url: {{host}}/query/growing/range
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "uri": "eml:///dataspace('demo/Volve')/witsml21.WellLog({{guid}})",
    "startIndex": 2500.0,
    "endIndex": 3000.0,
    "includeOverlapping": true
  }
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
