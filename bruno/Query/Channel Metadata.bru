meta {
  name: Channel Metadata
  type: http
  seq: 6
}

post {
  url: {{host}}/query/channels/metadata
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "uri": "eml:///dataspace('{{dataspaceIdRaw}}')/witsml21.WellLog({{guid}})"
  }
}

tests {
  test("status is 200 or 404 or 501", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404, 501]);
  });

  test("returns channels", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body).to.be.an("array");
    }
  });
}
