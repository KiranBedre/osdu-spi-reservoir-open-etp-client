meta {
  name: Get Multiple Objects
  type: http
  seq: 5
}

post {
  url: {{host}}/dataspaces/multi-resources/get-content
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "uris": [
      "eml:///dataspace('{{dataspaceIdRaw}}')/{{dataObjectType}}({{guid}})"
    ]
  }
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 404]);
  });
}
