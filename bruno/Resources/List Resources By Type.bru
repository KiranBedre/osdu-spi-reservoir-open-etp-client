meta {
  name: List Resources By Type
  type: http
  seq: 3
}

get {
  url: {{host}}/dataspaces/{{seededDataspaceId}}/resources/{{dataObjectType}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (Array.isArray(body) && body.length > 0) {
      // Resource objects carry the uuid inside the ETP uri: ...Type(uuid)
      const m = /\(([0-9a-fA-F-]{36})\)\s*$/.exec(body[0].uri || "");
      const uuid = body[0].uuid || (m && m[1]);
      if (uuid) {
        bru.setVar("guid", uuid);
      }
    }
  }
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("returns resources of requested type", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body).to.be.an("array");
    }
  });
}
