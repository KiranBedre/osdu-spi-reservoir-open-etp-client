meta {
  name: P06 Delete ProdML Dataspace
  type: http
  seq: 6
}

delete {
  url: {{host}}/dataspaces/{{prodmlDataspaceId}}
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Removes the folder-private PRODML dataspace created by P01.
}

tests {
  test("status is 200 or 204", function () {
    expect(res.getStatus()).to.be.oneOf([200, 204]);
  });
}
