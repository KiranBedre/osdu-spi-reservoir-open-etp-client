meta {
  name: P05 Get DTS Temperature Array Metadata
  type: http
  seq: 5
}

get {
  url: {{host}}/dataspaces/{{prodmlDataspaceId}}/resources/{{prodmlDtsObjType}}/{{prodmlDtsGuid}}/arrays/{{prodmlDtsArrayPath}}/metadata
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Read back the metadata for the externally-stored `adjustedTemperature` array
  produced by P04 at `/PRODML/<uuid>/adjustedTemperature`. When stored, the
  metadata reports a 1-D array of length 4 (one entry per DTS sample). Tolerant
  of 404 so the request also passes against a backend where DTS array extraction
  is disabled or JSON->XML shaping differs.
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("array metadata reports 4 samples when present", function () {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      const dims =
        (body && (body.Dimensions || body.dimensions)) || undefined;
      if (Array.isArray(dims)) {
        const total = dims.reduce((a, b) => a * Number(b), 1);
        expect(total).to.equal(4);
      }
    }
  });
}
