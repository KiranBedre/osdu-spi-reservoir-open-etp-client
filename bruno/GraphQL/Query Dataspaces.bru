meta {
  name: Query Dataspaces
  type: http
  seq: 2
}

post {
  url: {{graphqlHost}}
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "query": "query { dataspaces { uri name storeCreated } }"
  }
}

docs {
  Route coverage: POST /graphql — RootQueryResolver.dataspaces resolver. Exercises
  the ETP Store-backed dataspace listing through GraphQL (the graph-oriented
  read API), complementing the REST GET /dataspaces route.
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("dataspaces query resolves without errors", function () {
    const body = res.getBody();
    expect(body, JSON.stringify(body)).to.be.an("object");
    expect(body.errors, JSON.stringify(body.errors)).to.equal(undefined);
    expect(body.data.dataspaces).to.be.an("array");
  });
}
