meta {
  name: Find Objects
  type: http
  seq: 2
}

post {
  url: {{host}}/query/objects/find
  body: json
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "uri": "eml:///dataspace('{{dataspaceIdRaw}}')",
    "scope": "self",
    "depth": 1,
    "dataObjectTypes": ["{{dataObjectType}}"]
  }
}

tests {
  test("status is 200 or 404 or 501", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404, 501]);
  });
}
