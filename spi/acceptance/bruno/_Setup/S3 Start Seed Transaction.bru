meta {
  name: S3 Start Seed Transaction
  type: http
  seq: 4
}

post {
  url: {{host}}/dataspaces/{{testDataspaceId}}/transactions
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    // The server returns the transaction id as a bare string (see
    // Transactions.controller.ts PostTransaction -> Promise<string>).
    // Accept either a bare string or an object with a transactionId field.
    const transactionId =
      typeof body === "string"
        ? body.trim()
        : body && body.transactionId
          ? body.transactionId
          : undefined;
    if (transactionId) {
      bru.setVar("transactionId", transactionId);
    }
  }
}

tests {
  // On ACL-restricted envs the CI principal may lack permission to CREATE the
  // seed dataspace, so S2 tolerates 400/403 and the dataspace never exists.
  // In that case starting a transaction here returns 403/404 ("Dataspace not
  // found") - treat that as "seed skipped", consistent with S2 and with the
  // already-tolerant S4/S5/S6. Only require a transactionId when a transaction
  // was actually started (200/201).
  const status = res.getStatus();
  const started = status === 200 || status === 201;

  test("status is 200 or 201 (403/404 = dataspace not creatable, seed skipped)", function () {
    expect(status).to.be.oneOf([200, 201, 403, 404]);
  });

  if (started) {
    test("returns transactionId", function () {
      const transactionId = bru.getVar("transactionId");
      expect(transactionId, "transactionId captured from response").to.be.a("string").and.to.not.be.empty;
    });
  }
}
