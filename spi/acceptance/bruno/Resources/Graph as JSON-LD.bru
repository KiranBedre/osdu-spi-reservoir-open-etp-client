meta {
  name: Graph as JSON-LD (RDF)
  type: http
  seq: 13
}

get {
  url: {{host}}/dataspaces/{{dataspaceId}}/resources/all?edges=true
  body: none
  auth: none
}

params:query {
  edges: true
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
  Accept: application/ld+json
}

docs {
  Content-negotiated RDF view of the dataspace relationship graph.
  Sending `Accept: application/ld+json` returns the nodes-and-edges graph as a
  JSON-LD document (`@context` + `@graph`). Each node keeps its ETP URI as `@id`,
  its data-object type as `@type`, and outgoing relationships under `references`.
}

tests {
  test("status is 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });

  test("responds with JSON-LD when 200", function () {
    if (res.getStatus() === 200) {
      const ct = res.getHeader("content-type") || "";
      expect(ct).to.include("application/ld+json");
      const body = res.getBody();
      expect(body).to.have.property("@context");
      expect(body).to.have.property("@graph");
      expect(body["@graph"]).to.be.an("array");
    }
  });
}
