meta {
  name: G10 Drogon Graph Sources
  type: http
  seq: 10
}

get {
  url: {{host}}/dataspaces/{{drogonDataspaceId}}/graph/{{drogonGridType}}/{{drogonGridGuid}}/sources
  body: none
  auth: none
}

headers {
  data-partition-id: {{data-partition-id}}
  Authorization: Bearer {{access_token}}
}

docs {
  Drogon lifecycle (graph sources). Traverses the DOR edges that point AT the
  Drogon grid (e.g. properties referencing it) via graph/:type/:guid/sources
  (deprecated but live in M27). Tolerant of 400/404.
}

tests {
  test("status is documented (200/400/404)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
  });
}
