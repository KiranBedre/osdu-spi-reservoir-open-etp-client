# Dependency directories
node_modules/

# Build directories
dist/
# generated typedoc HTML (docs/ itself is tracked: docs/api holds the CIMPL OpenAPI baseline)
docs/typedoc/

# IDE and tooling
.vscode/
.husky/

# Local data and config. data/ is local scratch except the committed SMALL Drogon
# test fixture (whitelisted at the end of this file); the full-size Drogon is for
# local testing only via DROGON_DATA_DIR (see devops/scripts/stage-drogon-fixture.sh).
data/*
config.user.env
config.user.env.*
!config.user.env.sample
test-local-integration.sh
test-preship-integration.sh
RDDMS_M28_CIMPL_Preship.postman_environment.json
ToDo.md
M28_CI_Reservoir-DDMS_marcus.md
localtest/

# Generated by tests
*.bak

# Coverage and test reports
coverage/
*junit.xml
*lint-junit.xml
*lint-report.json

# env environment variables file
**/.env*
**/*.env
**/config.*.env
!**/config.default.env

# logs
*.log

# HDF5 data files (never commit binary data)
*.h5

# The one exception: the reduced Drogon fixture (~370 KB EPC + ~2.2 MB H5) that
# the Bruno/Postman Drogon suites upload. Must stay last so it beats data/* and *.h5.
!data/Demo_Drogon.epc
!data/drogon_small.h5
